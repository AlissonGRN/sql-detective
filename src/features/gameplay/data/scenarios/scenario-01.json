          "id": 1,
          "suspect_id": 1,
          "statement": "Entrei na Sala Bellmont para conferir a iluminação e saí poucos minutos depois."
        },
        {
          "id": 2,
          "suspect_id": 2,
          "statement": "Fiz apenas minha ronda normal. Não entrei na Sala Bellmont naquela noite."
        },
        {
          "id": 3,
          "suspect_id": 3,
          "statement": "Estava observando a Galeria Histórica e fui embora pouco depois das oito e meia."
        },
        {
          "id": 4,
          "suspect_id": 4,
          "statement": "Meu trabalho terminou antes do período noturno."
        },
        {
          "id": 5,
          "suspect_id": 5,
          "statement": "Passei praticamente toda a noite resolvendo problemas de manutenção."
        },
        {
          "id": 6,
          "suspect_id": 6,
          "statement": "Terminei minhas entrevistas e deixei o museu antes das oito."
        },
        {
          "id": 7,
          "suspect_id": 7,
          "statement": "Saí depois de terminar uma reunião administrativa."
        },
        {
          "id": 8,
          "suspect_id": 8,
          "statement": "Ajudei na organização das salas durante a tarde e fui embora no início da noite."
        }
      ]
